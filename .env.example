# Carpschool School Server - Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (No auth, internal network)
# In Docker Compose, the host is 'school-mongo'
MONGO_URI=mongodb://school-mongo:27017/school_db

# School Identification
SCHOOL_CODE=ubc
OFFICIAL_NAME=University of British Columbia
ALLOWED_EMAIL_DOMAINS=ubc.ca,student.ubc.ca,cs.ubc.ca
CAMPUS_NAME=Point Grey Campus
CAMPUS_ADDRESS=2329 West Mall, Vancouver, BC V6T 1Z4
CAMPUS_LATITUDE=49.2606
CAMPUS_LONGITUDE=-123.2460

# School Administrative Limits
MAX_CARPOOL_STUDENTS=4
MAX_HOMES_PER_USER=3

# School Server Ed25519 Cryptographic Keys (Base64 encoded 32-byte keys)
# Used to sign /api/v1/meta for automated Central Server onboarding
SCHOOL_ED25519_PRIVATE_KEY=YOUR_BASE64_ED25519_SECRET_KEY
SCHOOL_ED25519_PUBLIC_KEY=YOUR_BASE64_ED25519_PUBLIC_KEY

# Central Authority Server Ed25519 Public Key
# Used to verify incoming client Federation Tickets offline with 0 latency
CENTRAL_ED25519_PUBLIC_KEY=YOUR_BASE64_CENTRAL_PUBLIC_KEY
